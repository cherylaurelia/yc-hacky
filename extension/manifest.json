{
  "manifest_version": 3,
  "name": "Coworker",
  "version": "0.3.0",
  "description": "Coworker in Chrome: a queue of what your agents need, Allow/Deny in one click, and the full voice app in the side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Coworker",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "relay.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-talk": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "Start or stop talking to Coworker"
    }
  }
}
